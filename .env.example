# Development defaults. Copy to .env.docker for local Docker Compose.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-value

POSTGRES_DB=django_rpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# LLM: set LLM_PROVIDER=ollama and LLM_MODEL=<local model> for local use.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=10

GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Production: copy this file to .env.prod and replace all credentials and hosts.
ALLOWED_HOSTS=example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
FRONTEND_PORT=80
